{
  "name": "dsh-zh-thinking",
  "version": "0.1.0",
  "description": "强制 DeepSeek Harness 中的模型用简体中文思考与作答：注册一个常驻 system prompt section，对所有会话、工作区与子代理生效，不进入对话历史、不被上下文压缩丢弃。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "programerror233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programerror233/dsh-zh-thinking.git"
  },
  "homepage": "https://github.com/programerror233/dsh-zh-thinking#readme",
  "bugs": {
    "url": "https://github.com/programerror233/dsh-zh-thinking/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "dsh-plugin",
    "chinese",
    "reasoning",
    "thinking",
    "system-prompt",
    "中文",
    "思考"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
